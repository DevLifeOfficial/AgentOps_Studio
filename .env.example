# --- OTEL -> SigNoz -------------------------------------------------
# Default matches SigNoz's OTLP/HTTP receiver from the Foundry compose casting.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=agentops-studio

# --- SigNoz MCP server (self-diagnosis feature) ----------------------
# Enabled via casting.yaml (mcp.spec.enabled: true). Create the API key
# from SigNoz UI: Settings -> Service Accounts (requires Admin role).
SIGNOZ_MCP_URL=http://localhost:8000/mcp
SIGNOZ_API_KEY=

# --- LLM for diagnosis + (optionally) the agent's own reasoning ------
ANTHROPIC_API_KEY=

# --- UI ---------------------------------------------------------------
NEXT_PUBLIC_SIGNOZ_BASE_URL=http://localhost:8080
